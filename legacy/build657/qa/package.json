{
  "name": "meh-studio-manufacturing-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manufacturing, geometry, browser, and visual QA for MEH Studio v5.",
  "scripts": {
    "qa:headless-sweep": "node ../setting_sweep.js",
    "qa": "node node/run.mjs --tier quick",
    "qa:angular": "node node/angular-geometry-regression.mjs",
    "qa:radial": "node node/radial-adaptation-regression.mjs",
    "qa:tap-shapes": "node node/tap-shape-regression.mjs",
    "qa:pairwise-geometry": "node node/pairwise-geometry-regression.mjs",
    "qa:plan": "node node/plan-sweep.mjs",
    "qa:geometry": "node node/bounded-exact-witness.mjs",
    "qa:production-certificate": "node node/production-exact-certificate.mjs",
    "qa:browser": "node browser/run-visual-qa.mjs",
    "qa:render-inspection": "node browser/render-inspection.mjs",
    "qa:throat-morph-render": "node browser/render-inspection.mjs --throat-morph",
    "qa:tap-lumen-render": "node browser/render-inspection.mjs --tap-lumen",
    "qa:profile-laws-render": "node browser/render-inspection.mjs --profile-laws",
    "qa:wall-topologies-render": "node browser/render-inspection.mjs --wall-topologies",
    "qa:build649-render-board": "node browser/build649-closure-render-board.mjs",
    "qa:browser:release": "node browser/run-release-admission.mjs",
    "qa:ui-contracts": "node --test node/ui-regression-contracts.test.mjs",
    "qa:mount-envelope": "node --test node/mount-envelope-regression.test.mjs",
    "qa:section-families": "node --test node/section-family-control.test.mjs",
    "qa:rounded-section": "node --test node/rounded-rectangle-section.test.mjs",
    "qa:profile-controls": "node --test node/profile-control-parity.test.mjs",
    "qa:rosse-controls": "node --test node/profile-law-integration.test.mjs node/profile-control-parity.test.mjs && node browser/rosse-profile-controls.mjs",
    "qa:curved-facets": "node --test node/curved-facets-contract.test.mjs",
    "qa:angular-square": "node --test node/angular-square-endpoint-regression.test.mjs",
    "qa:analytic-preview": "node --test node/analytic-preview-topology-regression.test.mjs",
    "qa:swept-tap-frames": "node --test node/swept-tap-frame-continuity.test.mjs",
    "qa:driver-cd-clearance": "node --test node/driver-cd-flange-clearance.test.mjs",
    "qa:corner-plates": "node --test node/corner-driver-plate-regression.test.mjs",
    "qa:build650-osse-connectivity": "node --test node/build650-osse-panel-connectivity.test.mjs",
    "qa:array-placement": "node --test node/generalized-array-placement-regression.test.mjs",
    "qa:driver-manifold": "node --test node/driver-manifold-controls.test.mjs node/driver-manifold-regression.test.mjs",
    "qa:build649-state-depth": "node --test node/build649-state-depth-contract.test.mjs",
    "qa:build649-source-families": "node --test node/build649-source-family-contract.test.mjs",
    "qa:build649-state-mutation": "node browser/build649-state-mutation-contract.mjs",
    "qa:build651-delivery": "node --test node/build651-delivery-contract.test.mjs && node browser/build651-delivery-contract.mjs",
    "qa:build653-delivery": "node --test node/build653-delivery-contract.test.mjs && node browser/build653-delivery-contract.mjs",
    "qa:build654-source": "node --test node/build654-delivery-contract.test.mjs node/threeway-*.test.mjs",
    "qa:build654-delivery": "node --test node/build654-delivery-contract.test.mjs node/threeway-*.test.mjs && node browser/build654-delivery-contract.mjs",
    "qa:build655-source": "node --test node/build655-source-contract.test.mjs node/threeway-*.test.mjs",
    "qa:build655-delivery": "node --test node/build655-source-contract.test.mjs node/threeway-*.test.mjs && node browser/build655-delivery-contract.mjs",
    "qa:build655-visual": "MEH_BUILD655_ARTIFACT_DIR=artifacts/build655-threeway node browser/build655-delivery-contract.mjs",
    "qa:build655-package": "node release/build655-package-contract.mjs",
    "qa:build650-six-exact": "node --test node/build650-six-woofer-exact.test.mjs",
    "qa:build651-six-ui": "node browser/build651-six-woofer-ui.mjs",
    "qa:build653-six-ui": "node browser/build653-six-woofer-ui.mjs",
    "qa:build653-six-corner": "node browser/build653-six-corner-witness.mjs",
    "qa:build653-renderer-stress": "node browser/build653-renderer-stress.mjs",
    "qa:mount-persistence": "node --test node/saved-mount-persistence.test.mjs",
    "qa:threeway-containment": "node --test node/threeway-truth-containment.test.mjs",
    "qa:oneway-coax": "node --test node/oneway-coax-apex-regression.test.mjs",
    "qa:retention": "node --test node/cartridge-retention-regression.test.mjs",
    "qa:ath-source-math": "node --test node/ath-source-math.test.mjs",
    "qa:profile-laws": "node --test node/profile-laws-regression.test.mjs node/profile-law-integration.test.mjs",
    "qa:throat-morph": "node --test node/throat-morph-regression.test.mjs",
    "qa:tap-pair-spacing": "node --test node/tap-pair-spacing-regression.test.mjs",
    "qa:tap-lumen": "node node/tap-lumen-continuity.test.mjs",
    "qa:build649-user-state": "node --test node/build649-user-state-regression.test.mjs",
    "qa:build649-ledger": "node node/build649-closure-gate.mjs",
    "qa:release": "node node/run.mjs --tier release"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "ssim.js": "3.5.0",
    "three": "0.128.0"
  }
}
