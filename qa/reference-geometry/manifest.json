      ],
      "observations": [
        "Woofer modules repeat at equal angular intervals around a central HF hub.",
        "Complete circular driver frames and gaskets sit on continuous mounting lands.",
        "Driver bodies remain outside the acoustic flare and aim into the central manifold."
      ],
      "limitations": "Photographs establish rotational organization, not acoustic validity or exact adapter dimensions."
    },
    {
      "id": "manufacturing-invariants",
      "label": "derived-engineering-invariant",
      "authority": "numeric",
      "files": [],
      "observations": [
        "A through-wall tap envelope must remain under the active cone footprint.",
        "Driver and gasket envelopes must not overlap or protrude into horn air.",
        "A driver-bearing plate must be continuous from horn wall to gasket seat.",
        "A radial N-driver layout must use N equal angular sectors."
      ],
      "limitations": "These are manufacturability and topology gates, not substitutes for BEM/FEM or prototype measurements."
    },
    {
      "id": "render-descriptor-contract",
